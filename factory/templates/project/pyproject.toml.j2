# Generated by API Factory. Read-only for agents.
[project]
name = "{{ project_name }}"
version = "{{ api_version }}"
description = "{{ title }} (generated)"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn>=0.30",
    "sqlalchemy>=2.0",
    "pydantic>=2.7",
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "httpx>=0.27",
    "mypy>=1.11",
    "attrs>=23.0",
    "python-dateutil>=2.8",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "-p no:cacheprovider"

[tool.mypy]
python_version = "3.12"
strict = true
plugins = ["pydantic.mypy"]
files = ["app"]

[[tool.mypy.overrides]]
module = ["app.models"]
ignore_errors = true

[tool.ruff]
line-length = 100
target-version = "py312"
extend-exclude = ["app/models.py", "client", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]
