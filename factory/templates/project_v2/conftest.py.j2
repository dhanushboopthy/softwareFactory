"""Test fixtures. Generated by API Factory; read-only for every agent.

The harness hands pytest a database that already has the migrated schema (`alembic upgrade head`
was run on a template, and this run's database was cloned from it) and sets DATABASE_URL,
JWT_SECRET and a low PASSWORD_HASH_ITERATIONS. Before every test all tables are emptied.

`make_user` is the only way tests obtain a signed-in user, so replacing the login method (see
app/auth.py) means changing this one helper.
"""

import itertools
import os
from collections.abc import Callable, Iterator

import pytest

for _name in ("DATABASE_URL", "JWT_SECRET"):
    if not os.environ.get(_name):
        raise RuntimeError(f"{_name} must be set by the test harness before pytest starts")

from fastapi.testclient import TestClient  # noqa: E402
from sqlalchemy import text  # noqa: E402

from app.db import engine  # noqa: E402
from app.main import app  # noqa: E402

Headers = dict[str, str]
PASSWORD = "correct horse battery staple"
# Every table of the schema, generated from entities.yaml.
TABLES = {{ ((["users"] + (entities | map(attribute="table") | list))) | join(", ") | tojson }}


@pytest.fixture(autouse=True)
def clean_database() -> Iterator[None]:
    with engine.begin() as connection:
        connection.execute(text("SET LOCAL lock_timeout = '5s'"))
        connection.execute(text(f"TRUNCATE TABLE {TABLES} RESTART IDENTITY CASCADE"))
    yield


@pytest.fixture
def client() -> Iterator[TestClient]:
    with TestClient(app) as test_client:
        yield test_client


@pytest.fixture
def make_user(client: TestClient) -> Callable[..., Headers]:
    """Sign up and log in a new user; returns the Authorization headers for their requests."""
    counter = itertools.count(1)

    def make(email: str | None = None) -> Headers:
        address = email or f"user{next(counter)}@example.com"
        credentials = {"email": address, "password": PASSWORD}
        signup = client.post("/auth/signup", json=credentials)
        assert signup.status_code == 201, signup.text
        login = client.post("/auth/login", json=credentials)
        assert login.status_code == 200, login.text
        return {"Authorization": f"Bearer {login.json()['access_token']}"}

    return make


@pytest.fixture
def user_a(make_user: Callable[..., Headers]) -> Headers:
    return make_user("a@example.com")


@pytest.fixture
def user_b(make_user: Callable[..., Headers]) -> Headers:
    return make_user("b@example.com")
