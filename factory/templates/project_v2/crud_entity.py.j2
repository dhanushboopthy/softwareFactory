from fastapi import HTTPException
from sqlalchemy import select
from sqlalchemy.orm import Session

from app import models, orm
from app.crud import plain


def get(session: Session, {{ scope_param }}, id: int) -> orm.{{ e.name }}:
    stmt = select(orm.{{ e.name }}).where(orm.{{ e.name }}.id == id{{ scope_filter_suffix }})
    row = session.scalar(stmt)
    if row is None:
        raise HTTPException(status_code=404, detail="{{ e.name }} not found")
    return row


def list_(session: Session, {{ scope_param }}, limit: int, offset: int) -> list[orm.{{ e.name }}]:
    stmt = (
        select(orm.{{ e.name }})
{% if scope_filter %}
        .where({{ scope_filter }})
{% endif %}
        .order_by(orm.{{ e.name }}.id)
        .limit(limit)
        .offset(offset)
    )
    return list(session.scalars(stmt))


def create(session: Session, {{ scope_param }}, data: models.{{ e.name }}Create) -> orm.{{ e.name }}:
    row = orm.{{ e.name }}({{ scope_create_arg }}**plain(data.model_dump()))
    session.add(row)
    session.flush()
    return row


def update(session: Session, row: orm.{{ e.name }}, data: models.{{ e.name }}Update) -> None:
    for key, value in plain(data.model_dump(exclude_unset=True)).items():
        setattr(row, key, value)
    session.flush()


def delete(session: Session, row: orm.{{ e.name }}) -> None:
    session.delete(row)
    session.flush()


def to_model(row: orm.{{ e.name }}) -> models.{{ e.name }}:
    return models.{{ e.name }}.model_validate(
        {
            "id": row.id,
{% if e.parent %}
            "{{ parent_fk }}": row.{{ parent_fk }},
{% endif %}
{% for c in e.columns %}
            "{{ c.name }}": row.{{ c.name }},
{% endfor %}
        }
    )
