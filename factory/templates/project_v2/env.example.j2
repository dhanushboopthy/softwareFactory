# Copy to .env (never commit .env). The app refuses to start without DATABASE_URL and JWT_SECRET.
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/{{ app | replace("-", "_") }}
# Signing key for login tokens: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET=
# Password hashing cost (PBKDF2 iterations). Leave unset in production to use the default.
# PASSWORD_HASH_ITERATIONS=600000
