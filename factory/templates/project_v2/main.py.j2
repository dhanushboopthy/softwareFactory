@app.get("/health", include_in_schema=False)
def health() -> dict[str, str]:
    return {"status": "ok"}


@app.exception_handler(NotImplementedError)
async def not_implemented(_: Request, exc: NotImplementedError) -> JSONResponse:
    return JSONResponse(status_code=501, content={"detail": f"Not implemented: {exc}"})


@app.exception_handler(RuleViolation)
async def rule_violation(_: Request, exc: RuleViolation) -> JSONResponse:
    status = RULE_STATUS.get(exc.rule)
    if status is None:
        detail = f"a rules hook rejected the request with an undeclared rule id: {exc.rule!r}"
        return JSONResponse(status_code=500, content={"detail": detail})
    return JSONResponse(status_code=status, content={"detail": exc.message, "rule": exc.rule})


# --- Contract plumbing (framework quirks, not business logic) -----------------------------


@app.exception_handler(StarletteHTTPException)
async def http_error(_: Request, exc: StarletteHTTPException) -> Response:
    # Starlette answers undecodable request bodies with 400, which the spec does not document;
    # report them as the documented 422 validation error instead.
    if exc.status_code == 400:
        detail = [{"loc": ["body"], "msg": str(exc.detail), "type": "json_invalid"}]
        return JSONResponse(status_code=422, content={"detail": detail})
    return JSONResponse(
        status_code=exc.status_code, content={"detail": exc.detail}, headers=exc.headers
    )


@app.middleware("http")
async def allow_header(
    request: Request, call_next: Callable[[Request], Awaitable[Response]]
) -> Response:
    # On 405, list every method the path supports (Starlette only lists the first route's).
    response = await call_next(request)
    if response.status_code == 405:
        methods: set[str] = set()
        for route in app.routes:
            if isinstance(route, APIRoute) and route.path_regex.match(request.url.path):
                methods |= route.methods or set()
        response.headers["Allow"] = ", ".join(sorted(methods))
    return response
