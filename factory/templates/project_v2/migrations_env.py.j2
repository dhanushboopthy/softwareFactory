"""Alembic environment. Generated by API Factory; read-only for agents.

The URL comes from DATABASE_URL and the metadata from app.orm, which is itself generated from
entities.yaml, so the schema can only change by changing (and re-approving) that file.
"""

import os

from alembic import context
from sqlalchemy import create_engine

from app import orm

target_metadata = orm.Base.metadata


def run_migrations_online() -> None:
    engine = create_engine(os.environ["DATABASE_URL"])
    with engine.connect() as connection:
        context.configure(connection=connection, target_metadata=target_metadata)
        with context.begin_transaction():
            context.run_migrations()
    engine.dispose()


run_migrations_online()
