# Generated by API Factory from entities.yaml. Read-only for agents.
[project]
name = {{ project_name | tojson }}
version = "1.0.0"
description = {{ (title ~ " (generated)") | tojson }}
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn>=0.30",
    "sqlalchemy>=2.0",
    "pydantic>=2.7",
    "alembic>=1.13",
    "psycopg[binary]>=3.2",
    "pyjwt>=2.8",
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "httpx>=0.27",
    "mypy>=1.11",
    "attrs>=23.0",
    "python-dateutil>=2.8",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "-p no:cacheprovider"
markers = ["rule(id): the entities.yaml rule id this test covers"]

[tool.mypy]
python_version = "3.12"
strict = true
plugins = ["pydantic.mypy"]
files = ["app"]

[[tool.mypy.overrides]]
module = ["app.models"]
ignore_errors = true

[tool.ruff]
line-length = 100
target-version = "py312"
extend-exclude = ["app/models.py", "client", "tests", "migrations"]

[tool.ruff.lint]
# No "I" (import sorting): it would fail iterations on cosmetics the model cannot see.
select = ["E", "F", "UP", "B", "SIM"]
