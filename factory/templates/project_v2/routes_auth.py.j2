"""Signup and login. Generated by API Factory; read-only for agents."""

from fastapi import APIRouter, HTTPException
from sqlalchemy import select
from sqlalchemy.exc import IntegrityError

from app import models, orm
from app.auth import create_token, hash_password, verify_password
from app.db import SessionDep

router = APIRouter(tags=["auth"])


@router.post("/auth/signup", status_code=201, response_model=models.User, operation_id="signup")
def signup(body: models.Credentials, session: SessionDep) -> models.User:
    """Create an account. Emails are case-insensitive and unique."""
    email = body.email.strip().lower()
    if session.scalar(select(orm.User).where(orm.User.email == email)) is not None:
        raise HTTPException(status_code=409, detail="Email already registered")
    user = orm.User(email=email, password_hash=hash_password(body.password))
    session.add(user)
    try:
        session.commit()
    except IntegrityError:  # a concurrent signup won the race
        session.rollback()
        raise HTTPException(status_code=409, detail="Email already registered") from None
    return models.User.model_validate({"id": user.id, "email": user.email})


@router.post("/auth/login", response_model=models.Token, operation_id="login")
def login(body: models.Credentials, session: SessionDep) -> models.Token:
    """Exchange email and password for a bearer token."""
    email = body.email.strip().lower()
    user = session.scalar(select(orm.User).where(orm.User.email == email))
    if user is None or not verify_password(body.password, user.password_hash):
        raise HTTPException(
            status_code=401,
            detail="Wrong email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )
    return models.Token.model_validate(
        {"access_token": create_token(user.id), "token_type": "bearer"}
    )
