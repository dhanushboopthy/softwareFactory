@pytest.mark.parametrize(("steps", "target"), {{ t.moves | pyrepr }})
def test_allowed_{{ t.field }}_moves(
    client: TestClient, user_a: Headers, steps: tuple[str, ...], target: str
) -> None:
    pid = new_parent(client, user_a)
    url = item(pid, create(client, user_a, pid)["id"])
    for step in [*steps, target]:
        response = client.patch(url, json={"{{ t.field }}": step}, headers=user_a)
        assert response.status_code == 200, (step, response.text)
        assert response.json()["{{ t.field }}"] == step
    assert client.get(url, headers=user_a).json()["{{ t.field }}"] == target


@pytest.mark.parametrize(("steps", "target"), {{ t.bad | pyrepr }})
def test_disallowed_{{ t.field }}_moves_are_rejected(
    client: TestClient, user_a: Headers, steps: tuple[str, ...], target: str
) -> None:
    pid = new_parent(client, user_a)
    url = item(pid, create(client, user_a, pid)["id"])
    for step in steps:
        assert client.patch(url, json={"{{ t.field }}": step}, headers=user_a).status_code == 200
    current = client.get(url, headers=user_a).json()["{{ t.field }}"]
    response = client.patch(url, json={"{{ t.field }}": target}, headers=user_a)
    assert response.status_code == 409, response.text
    assert response.json()["rule"] == {{ t.rule_id | tojson }}
    assert client.get(url, headers=user_a).json()["{{ t.field }}"] == current
