def new_parent(client: TestClient, headers: Headers) -> int | None:
{% if e.parent %}
    response = client.post(PARENT_COLLECTION, json=PARENT_PAYLOAD, headers=headers)
    assert response.status_code == 201, response.text
    return int(response.json()["id"])
{% else %}
    return None
{% endif %}


def collection(pid: int | None) -> str:
{% if e.parent %}
    return f"/{{ parent.plural }}/{pid}/{{ e.plural }}"
{% else %}
    return {{ e.collection | tojson }}
{% endif %}


def item(pid: int | None, row_id: int) -> str:
    return f"{collection(pid)}/{row_id}"


def create(
    client: TestClient, headers: Headers, pid: int | None, n: int = 1, **overrides: Any
) -> dict[str, Any]:
    response = client.post(
        collection(pid), json={**PAYLOADS[n - 1], **overrides}, headers=headers
    )
    assert response.status_code == 201, response.text
    body: dict[str, Any] = response.json()
    return body


def test_every_operation_requires_a_token(client: TestClient) -> None:
    calls: list[tuple[str, str, Any]] = [
        ("POST", collection(1), PAYLOADS[0]),
        ("GET", collection(1), None),
        ("GET", item(1, 1), None),
        ("PATCH", item(1, 1), {}),
        ("DELETE", item(1, 1), None),
{% for a in e.actions %}
        ("POST", item(1, 1) + "/{{ a.name }}", None),
{% endfor %}
    ]
    for method, url, body in calls:
        missing = client.request(method, url, json=body)
        assert missing.status_code == 401, (method, url, missing.text)
        bad = client.request(
            method, url, json=body, headers={"Authorization": "Bearer not-a-real-token"}
        )
        assert bad.status_code == 401, (method, url, bad.text)


def test_create_then_read_back(client: TestClient, user_a: Headers) -> None:
    pid = new_parent(client, user_a)
    created = create(client, user_a, pid)
    for key, value in PAYLOADS[0].items():
        if key not in SKIP_ECHO:
            assert created[key] == value, key
{% if e.parent %}
    assert created["{{ e.parent_param }}"] == pid
{% endif %}
{% for t in transitions %}
    assert created["{{ t.field }}"] == {{ t.start | tojson }}
{% endfor %}
    fetched = client.get(item(pid, created["id"]), headers=user_a)
    assert fetched.status_code == 200
    assert fetched.json() == created
    assert created in client.get(collection(pid), headers=user_a).json()


def test_update_changes_only_the_given_fields(client: TestClient, user_a: Headers) -> None:
    pid = new_parent(client, user_a)
    created = create(client, user_a, pid)
    url = item(pid, created["id"])
    assert client.patch(url, json={}, headers=user_a).json() == created
    if PATCH:
        response = client.patch(url, json=PATCH, headers=user_a)
        assert response.status_code == 200, response.text
        updated = response.json()
        for key, value in created.items():
            if key not in SKIP_ECHO:
                assert updated[key] == PATCH.get(key, value), key
        assert client.get(url, headers=user_a).json() == updated


def test_delete_removes_the_row(client: TestClient, user_a: Headers) -> None:
    pid = new_parent(client, user_a)
    created = create(client, user_a, pid)
    url = item(pid, created["id"])
    assert client.delete(url, headers=user_a).status_code == 204
    assert client.get(url, headers=user_a).status_code == 404
    assert created not in client.get(collection(pid), headers=user_a).json()
    assert client.delete(url, headers=user_a).status_code == 404


def test_lists_are_paged_in_id_order(client: TestClient, user_a: Headers) -> None:
    pid = new_parent(client, user_a)
    ids = [create(client, user_a, pid, n)["id"] for n in (1, 2, 3)]

    def page(**params: int) -> list[int]:
        response = client.get(collection(pid), params=params, headers=user_a)
        assert response.status_code == 200, response.text
        return [row["id"] for row in response.json()]

    assert page() == ids
    assert page(limit=2) == ids[:2]
    assert page(limit=2, offset=2) == ids[2:]
    assert page(offset=3) == []
    for params in ({"limit": 0}, {"limit": LIMIT_MAX + 1}, {"offset": -1}):
        response = client.get(collection(pid), params=params, headers=user_a)
        assert response.status_code == 422, (params, response.text)
