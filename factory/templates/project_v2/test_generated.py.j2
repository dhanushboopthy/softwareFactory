def test_deleting_the_parent_deletes_its_{{ e.plural }}(
    client: TestClient, user_a: Headers
) -> None:
    pid = new_parent(client, user_a)
    create(client, user_a, pid, 1)
    create(client, user_a, pid, 2)
    assert client.delete(f"{PARENT_COLLECTION}/{pid}", headers=user_a).status_code == 204
    with engine.connect() as connection:
        count = connection.execute(text("SELECT count(*) FROM {{ e.table }}")).scalar_one()
    assert count == 0
