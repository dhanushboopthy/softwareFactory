{% extends "base.html.j2" %}
{% block title %}{{ shown }} · {{ run_id }} · API Factory{% endblock %}
{% block content %}
<p><a href="/runs/{{ run_id }}">← run {{ run_id }}</a></p>
<section class="panel">
  <h2>
    <a href="/runs/{{ run_id }}/files">files</a>
{% for label, path in crumbs %}
    / <a href="/runs/{{ run_id }}/files/{{ path }}">{{ label }}</a>
{% endfor %}
  </h2>
{% if entries is not none %}
{% if entries %}
  <table>
    <tbody>
{% for e in entries %}
      <tr><td><a href="/runs/{{ run_id }}/files/{{ e.path }}">{{ e.name }}{{ '/' if e.is_dir else '' }}</a></td>
          <td class="num muted">{{ '' if e.is_dir else e.size ~ ' bytes' }}</td></tr>
{% endfor %}
    </tbody>
  </table>
{% else %}
  <p class="muted">Nothing to show here.</p>
{% endif %}
{% elif view.binary %}
  <p class="muted">This is a binary file; it is not shown.</p>
{% else %}
  <pre>{{ view.text }}</pre>
{% if view.truncated %}
  <p class="hint">Only the first {{ limit }} bytes are shown.</p>
{% endif %}
{% endif %}
</section>
{% endblock %}
